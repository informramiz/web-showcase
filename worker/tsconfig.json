{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["./**/*.ts"]
}
