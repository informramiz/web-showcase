# Local development. Copy to .env.local; every value is optional.
# On Cloudflare these are Worker secrets (wrangler secret put ...), not files.

# DATABASE_PATH=./data/teamboard.db
# UPLOADS_DIR=./data/uploads
# REALTIME_TRANSPORT=sse            # or "poll"

# Stripe TEST MODE only (sk_test_..., whsec_..., price_...). Billing stays hidden unless all three are set.
# Webhooks locally: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
